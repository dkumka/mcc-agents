[Unit]
Description=MCC agents service
After=network.target

[Service]
User=klemid
Group=klemid
WorkingDirectory=/home/klemid/.local/share/mcc-klemid/agents
Environment=HOME=/home/klemid NODE_ENV=production
Environment=PATH=/home/klemid/.local/share/node/node-v24.22.3-linux-x64/bin:/home/klemid/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=AGENTD_PROJECT_ROOTS=/home/klemid/dev:/home/klemid/dev/supa AGENTD_NOTIFY=0
Environment=AGENTD_SOCKET=/run/mcc-agents/agentd.sock AGENTD_LOCAL_SOCKET=/run/mcc-agents/local.sock
ExecStart=/home/klemid/.local/share/node/node-v24.22.3-linux-x64/bin/node apps/agentd/src/index.ts
Restart=on-failure
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=multi-user.target
